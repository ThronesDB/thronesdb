# Settings for the app (Symfony) inside the containers. These override the
# defaults in the repository's .env file. Copy to app.env, fill in, chmod 600.

APP_ENV=prod
# A long random string, e.g. from: openssl rand -hex 32
APP_SECRET=

# Apache worker cap (each holds a PHP interpreter; ~30-60 MB each)
APACHE_MAX_WORKERS=10

# Outgoing mail (registration confirmations, password resets, notifications).
# Leave SMTP_HOST empty to send nothing. SMTP_TLS: starttls (default), tls, off.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Branding
APP_WEBSITE_NAME=ThronesDB
# The public hostname, without scheme or port. In prod the app redirects any
# other hostname to this one (localhost for a local test), and serves Spanish
# at es.<hostname> (config/packages/jms_i18n_routing.yaml).
APP_WEBSITE_URL=thronesdb.com
APP_GAME_NAME="A Game of Thrones"
APP_PUBLISHER_NAME="Fantasy Flight Games"
APP_EMAIL_SENDER_ADDRESS=no-reply@thronesdb.com
APP_EMAIL_SENDER_NAME=Admin
APP_DESIGN_TEAM_URL=
APP_GOOGLE_ANALYTICS_TRACKING_CODE=
APP_ALLOW_SEARCH_ENGINE_TRACKING=false
APP_CACHE_EXPIRATION=600
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Optional: "init" creates this super-admin account if it doesn't exist
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
