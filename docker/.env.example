# Settings for docker compose itself and the database container.
# Copy to .env, fill in, chmod 600. Never commit the copy.

# Prefix for the project, container and image names
COMPOSE_PROJECT_NAME=thronesdb

# Host ports, bound to 127.0.0.1 only
APP_PORT=8000
DB_PORT=3307

# Database. The app builds its DATABASE_URL from these, so keep the
# passwords URL-safe (letters, digits, - and _).
MYSQL_DATABASE=thronesdb
MYSQL_USER=thronesdb
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Memory caps (docker mem_limit)
APP_MEM_LIMIT=1g
DB_MEM_LIMIT=1g

# Card data repository cloned by "init"
CARD_DATA_REPO=https://github.com/throneteki/throneteki-json-data.git

# Development: uncomment to load docker-compose.dev.yml automatically
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
#MAILPIT_PORT=8025
