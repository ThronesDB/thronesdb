{
  "name": "thronesdb/thronesdb",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-fixtures-bundle": "^3.6 || ^4.0",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^2.20",
    "erusev/parsedown": "^1.7",
    "ezyang/htmlpurifier": "^4.17",
    "friendsofsymfony/jsrouting-bundle": "^3.5",
    "friendsofsymfony/user-bundle": "^4.1",
    "guzzlehttp/guzzle": "^7.9",
    "league/oauth2-server-bundle": "^1.2",
    "nelmio/api-doc-bundle": "^5.0",
    "nelmio/cors-bundle": "^2.5",
    "phpdocumentor/reflection-docblock": "^5.4",
    "ramsey/uuid-doctrine": "^2.1",
    "stof/doctrine-extensions-bundle": "^1.13",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/flex": "^2.4",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/twig": "^3.14",
    "willdurand/js-translation-bundle": "^7.0 || ^8.0"
  },
  "require-dev": {
    "beberlei/assert": "^3.3",
    "justinrainbow/json-schema": "^5.3 || ^6.0",
    "mockery/mockery": "^1.6",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.0",
    "squizlabs/php_codesniffer": "^3.11",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/phpunit-bridge": "7.4.*"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.4.0"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "7.4.*"
    }
  }
}
